# Server-side only. Never expose CALLE_API_KEY via NEXT_PUBLIC_*.
CALLE_API_KEY=
CALLE_BASE_URL=https://api.heycall-e.com

# Safety gate: keep false until CALL-E credentials, consent/compliance, webhook handling and production limits are reviewed.
CALLE_LIVE_ENABLED=false

# Additional production gate: keep false for public/demo deployments.
ACTIONBRIDGE_ALLOW_PROD_LIVE=false

# Dedicated HMAC secret for ActionBridge plan/approval tokens. Use a strong random value in controlled live environments.
ACTIONBRIDGE_APPROVAL_SECRET=

# Optional public HTTPS endpoint that CALL-E should call for terminal results.
ACTIONBRIDGE_WEBHOOK_URL=
