# Server-side only. Never expose CALLE_API_KEY via NEXT_PUBLIC_*.
CALLE_API_KEY=
CALLE_BASE_URL=https://api.heycall-e.com

# Safety gate: keep false until CALL-E credentials, webhook and production limits are reviewed.
CALLE_LIVE_ENABLED=false

# Optional public HTTPS endpoint that CALL-E should call for terminal results.
ACTIONBRIDGE_WEBHOOK_URL=

# Optional shared secret for the webhook receiver.
CALLE_WEBHOOK_SECRET=
